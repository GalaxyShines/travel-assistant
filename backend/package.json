{
  "name": "travel-helper-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MySQL API for the travel map planner.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "build": "esbuild src/server.js --bundle --platform=node --target=node18 --format=cjs --outfile=dist/server.js",
    "init-db": "node scripts/init-db.js",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "nodemon": "^3.1.9"
  }
}
