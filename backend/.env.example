# Service information
APP_NAME=旅行规划地图

# HTTP server and CORS
BACKEND_PORT=9077
CORS_ORIGIN=http://your-frontend-domain.example

# Public app metadata
BAIDU_MAP_AK=replace-with-your-baidu-map-ak

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=travel_helper
